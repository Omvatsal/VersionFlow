NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=local-docker-secret-change-this-to-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
DOCKER_DATABASE_URL=postgres://postgres:postgres@postgres:5432/versionflow_dev
DOCKER_REDIS_URL=redis://redis:6379
DATABASE_URL=postgres://postgres:postgres@postgres:5432/versionflow_dev
REDIS_URL=redis://redis:6379
WORKER_CONCURRENCY=5
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional OAuth and GitHub App values. Keep secrets out of images and source control.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=http://localhost:4000/api/v1/integrations/github/callback
GITHUB_APP_WEBHOOK_SECRET=
