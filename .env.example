# Environment
NODE_ENV=development

# NestJS API
PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=http://localhost:4000/api/v1/integrations/github/callback
GITHUB_APP_WEBHOOK_SECRET=

# Next.js Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL & Drizzle ORM
DATABASE_URL=postgres://postgres:postgres@localhost:5432/versionflow_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=versionflow_dev
POSTGRES_PORT=5432

# Redis & BullMQ
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

# Worker Configuration
WORKER_CONCURRENCY=5

